# Environment Variables Configuration

# ===========================================
# Hugging Face Configuration
# ===========================================
# Your Hugging Face Space identifier (format: username/space-name)
HF_SPACE_ID=Henri4679/pneumonia-xray

# The API endpoint name in your Gradio Space
HF_API_NAME=/predict

# Hugging Face API token (only needed if Space is private)
# Get your token from: https://huggingface.co/settings/tokens
# HF_API_TOKEN=hf_your_token_here

# ===========================================
# Backend Configuration
# ===========================================
# Port for the backend server (Render sets this automatically)
PORT=8000

# Python configuration
PYTHONUNBUFFERED=1

# Optional: Path to local PyTorch model (if using local inference instead of HF)
# MODEL_PATH=/app/backend/models/model.pt

# ===========================================
# Frontend Configuration (Development Only)
# ===========================================
# API URL for frontend in development (not needed for production Docker build)
# VITE_API_URL=http://localhost:8000/api

# ===========================================
# INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env for local development:
#    cp .env.example .env
#
# 2. Update the values in .env (never commit .env to git!)
#
# 3. For Render deployment:
#    - Don't create .env file on Render
#    - Set environment variables in Render Dashboard
#    - Or use render.yaml (already configured)
#
# 4. Required variables:
#    - HF_SPACE_ID (must match your Hugging Face Space)
#    - HF_API_NAME (default: /predict)
#
# 5. Optional variables:
#    - HF_API_TOKEN (only if Space is private)
#    - MODEL_PATH (only if using local PyTorch model)
